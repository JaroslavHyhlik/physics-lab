{
  "name": "physics-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive physics simulations for IB Physics HL and a mobile sensor lab",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:audit": "AUDIT=1 playwright test tests/e2e/audit.spec.ts tests/e2e/responsive.spec.ts tests/e2e/navigation.spec.ts",
    "test:inventory": "AUDIT=1 playwright test tests/e2e/inventory.spec.ts --project=desktop --workers=1",
    "test:all": "npm test && npm run check && npm run test:e2e && npm run test:audit",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.70.0",
    "katex": "^0.19.1",
    "qrcode-generator": "^2.0.4",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
